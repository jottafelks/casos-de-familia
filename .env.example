# Copie para .env (nunca versionado) ou preencha no painel do Render.
PORT=3000
NODE_ENV=production

# Voz em redes móveis restritivas (opcional).
# Sem isso o jogo usa STUN público — funciona na maioria dos casos.
# O servidor entrega essas credenciais por GET /api/ice para criar as
# conexões WebRTC; elas NUNCA aparecem no código do navegador.
# TURN_URL=turn:exemplo.com:3478
# TURN_USER=usuario
# TURN_PASS=senha

# Apenas para testes automatizados (permite encurtar o cronômetro).
# Deixe vazio em produção.
# TEST_HOOKS=1
